# Patchline environment template. Copy to .env and fill in.

# --- Required ---
GITHUB_APP_ID=
# Preferred: path to the PEM file (mounted secret). Env-var PEM content also accepted (see below).
GITHUB_APP_PRIVATE_KEY_PATH=
# Alternative to the path: raw PEM content. Literal "\n" sequences are converted to real newlines.
# GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Sole source of truth for the vendor allowlist; re-read from the environment on every request.
GITHUB_ALLOWLISTED_LOGIN=
# mock | sneferu
ENGINE_MODE=mock
# Required when ENGINE_MODE=sneferu:
SNEFERU_BASE_URL=
SNEFERU_SERVICE_TOKEN=
# Engine workflow names (configuration values, injected as WorkflowConfig — never in adapter signatures).
ENGINE_WORKFLOW_DERIVE=derive_patterns
ENGINE_WORKFLOW_SCAN=scan_repository
ENGINE_WORKFLOW_REMEDIATE=generate_remediation
SESSION_SECRET=
DATABASE_URL=sqlite:///./patchline.db
DEFAULT_LANGUAGE=python

# --- Optional ---
# Both must be set together or both unset (verify-config enforces the pairing).
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_SIGNING_SECRET=
# Deployment identifier. If unset, a stable ID is generated on first run and persisted in Config.
INSTANCE_ID=
# Periodic background rescan cadence (hours). Default 168 (weekly).
RESCAN_INTERVAL_HOURS=168
# test only; default not set. Overrides RESCAN_INTERVAL_HOURS when set (e.g. =2 for tests).
RESCAN_INTERVAL_SECONDS=
# test only; default 900 (15 min). Step-up re-authentication freshness threshold for dispatch.
SESSION_STEP_UP_AGE_SECONDS=
# demo mode: pre-seeded session, mock GitHub fixtures, dispatch disabled.
DEMO_MODE=false
# allow destructive migrations without the CLI flag (only DROP TABLE / DROP COLUMN / ALTER TABLE ... DROP are destructive).
ALLOW_DESTRUCTIVE_MIGRATIONS=false
# warn in verify-config when any installation exceeds this many repositories. Default 20.
MAX_REPOS_PER_INSTALLATION=20
# coalesce per-repository notification bursts into a batch payload. Default 0 (no batching).
NOTIFICATION_BATCH_WINDOW_SECONDS=0
# override worker heartbeat file location (default /data/.worker_heartbeat).
WORKER_HEARTBEAT_PATH=
